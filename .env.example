# Hugging Face read token: https://huggingface.co/settings/tokens
# The same account must have accepted the license on https://huggingface.co/facebook/sam-audio-small
# (and https://huggingface.co/facebook/sam-audio-large for the large models).
HF_ACCESS_TOKEN=

# Optional: where the web app listens (Docker sets AF_HOST=0.0.0.0)
# AF_HOST=127.0.0.1
# AF_PORT=8000
